# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# MONGODB_URI: Optional. Leave empty to use unified in-memory mock repository.
# Add your MongoDB connection string here to persist data across sessions.
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/leaddesk?retryWrites=true&w=majority"

# FIREBASE WEB CONFIGURATION (Client-Side Vite Environment Variables)
# Add these in Vercel (Project Settings > Environment Variables) or your local .env
# Client environment variables in Vite must start with VITE_
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="atomic-casing-dtgzl.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="atomic-casing-dtgzl"
VITE_FIREBASE_STORAGE_BUCKET="atomic-casing-dtgzl.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="535514239581"
VITE_FIREBASE_APP_ID="1:535514239581:web:7c3d90e255fd53f4f633b4"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-leaddesk-f7356773-eda0-4611-b6e3-dc82182847ae"
