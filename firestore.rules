rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Push notification subscriptions
    match /notification_subscriptions/{subscriptionId} {
      allow read, write: if isValidId(subscriptionId);
    }

    // Follow-up reminder notification delivery logs
    match /notification_logs/{logId} {
      allow read, create: if isValidId(logId);
      allow update, delete: if false;
    }
  }
}
